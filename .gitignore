# Bilty Management - Files to ignore

# Database dumps
*.sql
*.sqlite

# Uploaded files / Generated PDFs (if you want to exclude them)
bilty_pdfs/*.pdf

# System files
.DS_Store
Thumbs.db
*.log

# Temporary files
tmp/
temp/
*.tmp
codeigniter3_temp/
codeigniter-hmvc-modules-master/
*.tar.gz

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files
.env
.env.local

# Backup files
*.bak
*.backup

# Old backup files
old_*.php
old*.zip
